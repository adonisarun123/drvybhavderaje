# ---- Required ---------------------------------------------------------------
# Neon Postgres connection string (server-side only; never expose to the browser).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Canonical origin of this deployment. Used for canonical URLs, sitemap, CSRF/origin checks and auth cookies.
SITE_ORIGIN="https://drvybhavderaje.com"
# Secret for Better Auth session signing. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=""
# One-time token used by /admin/setup to create the FIRST administrator. Remove after setup.
ADMIN_SETUP_TOKEN=""

# ---- Feature switches --------------------------------------------------------
# Public consultation requests are only accepted when this is "true" AND the database is reachable.
ENQUIRIES_ENABLED="false"
# Search-engine indexing is only enabled when "true" (and never on Vercel preview deployments).
PUBLIC_INDEXING="false"

# ---- Optional integrations ---------------------------------------------------
# Email notifications via Resend. Without both values nothing is sent and the log records not_configured.
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="Clinic <no-reply@drvybhavderaje.com>"
# Cloudflare Turnstile bot protection for the public form (optional; honeypot + timing + rate limits apply regardless).
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Salt for hashing visitor IP addresses in enquiry records (defaults to BETTER_AUTH_SECRET).
IP_HASH_SALT=""

# ImageKit URL endpoint (incl. the media-library folder) used for every site image. See lib/images.ts.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/meddeskos/drvybhavderaje"
